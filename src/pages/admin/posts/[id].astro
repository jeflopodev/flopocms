            <button type="button" id="confirm-asset-modal-btn" class="btn btn-primary" disabled>
              Insert Selected Asset
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Initial Data Payload -->
    <script id="initial-post-data" type="application/json" set:html={JSON.stringify({
      id: post.id,
      slug: post.slug,
      title: post.title,
      description: post.description || "",
      category: post.category || "General",
      tags: parsedTags,
      author: post.author || "jeflopo",
      featured_image: post.featuredImage || (post as any).featured_image || "",
      content_mdx: post.contentMdx || (post as any).content_mdx || "",
      status: post.status || "draft",
      template: post.template || "default",
      default_width: post.defaultWidth || (post as any).default_width || "60rem",
      wide_width: post.wideWidth || (post as any).wide_width || "70rem",
      pub_date: post.pubDate || (post as any).pub_date || "",
    })} />

    <script id="initial-assets-data" type="application/json" set:html={JSON.stringify(initialAssets)} />

    <!-- CodeMirror & Editor Logic Script -->
    <script>
      import { EditorView, basicSetup } from "codemirror";
      import { markdown } from "@codemirror/lang-markdown";
      import { slugify } from "../../../utils/slugify";

      // Parse initial data
      const dataScript = document.getElementById("initial-post-data");
      const postData = JSON.parse(dataScript?.textContent || "{}");

      const assetsScript = document.getElementById("initial-assets-data");
      let allAssets = JSON.parse(assetsScript?.textContent || "[]");

      // DOM Elements
      const container = document.getElementById("codemirror-container");
      const topbarTitleInput = document.getElementById("topbar-title-input") as HTMLInputElement;
      const postTitleField = document.getElementById("post-title-field") as HTMLInputElement;
      const postSlugField = document.getElementById("post-slug-field") as HTMLInputElement;
      const resyncSlugBtn = document.getElementById("resync-slug-btn");
      const postTemplateSelect = document.getElementById("post-template-select") as HTMLSelectElement;
      const postDefaultWidthField = document.getElementById("post-default-width-field") as HTMLInputElement;
      const postWideWidthField = document.getElementById("post-wide-width-field") as HTMLInputElement;
      const postDescField = document.getElementById("post-desc-field") as HTMLTextAreaElement;
      const postCategoryField = document.getElementById("post-category-field") as HTMLSelectElement;
      const postAuthorField = document.getElementById("post-author-field") as HTMLSelectElement;
      const postPubdateField = document.getElementById("post-pubdate-field") as HTMLInputElement;
      const postStatusSelect = document.getElementById("post-status-select") as HTMLSelectElement;
      const postTagsField = document.getElementById("post-tags-field") as HTMLInputElement;
      const postImageField = document.getElementById("post-image-field") as HTMLInputElement;
      const browseHeroImageBtn = document.getElementById("browse-hero-image-btn");
      const saveIndicator = document.getElementById("save-indicator");
      const saveIndicatorText = saveIndicator?.querySelector(".indicator-text");
      const manualSaveBtn = document.getElementById("manual-save-btn");
      const publishBtn = document.getElementById("publish-btn");
      const previewLink = document.getElementById("preview-link") as HTMLAnchorElement;
      const statusBadge = document.getElementById("post-status-badge");

      // Drawer Toggles
      const drawer = document.getElementById("editor-drawer");
      const drawerHeading = document.getElementById("drawer-heading");
      const drawerCloseBtn = document.getElementById("drawer-close-btn");
      const toggleSettingsBtn = document.getElementById("toggle-settings-btn");
      const toggleBlocksBtn = document.getElementById("toggle-blocks-btn");
      const settingsPanel = document.getElementById("settings-panel-content");
      const blocksPanel = document.getElementById("blocks-panel-content");

      // State
      let activePanel: "settings" | "blocks" | "none" = "settings";
      let isSaving = false;
      let isDirty = false;
      let autoSaveTimer: any = null;
      let isSlugManuallyEdited = false;

      // Initialize CodeMirror 6
      const themeConfig = EditorView.theme({
        "&": {
          height: "100%",
          fontSize: "15px",
          color: "var(--text-primary)",
          backgroundColor: "var(--bg-surface)",
        },
        ".cm-scroller": {
          overflow: "auto",
          fontFamily: "var(--font-mono)",
          lineHeight: "1.65",
        },
        ".cm-content": {
          padding: "24px 32px",
          maxWidth: "960px",
          margin: "0 auto",
        },
        ".cm-line": {
          padding: "0",
        },
        "&.cm-focused .cm-cursor": {
          borderLeftColor: "var(--primary)",
          borderLeftWidth: "2px",
        },
        "&.cm-focused .cm-selectionBackground, .cm-selectionBackground, .cm-content ::selection": {
          backgroundColor: "rgba(79, 70, 229, 0.18)",
        },
        ".cm-gutters": {
          backgroundColor: "var(--bg-surface-elevated)",
          color: "var(--text-muted)",
          borderRight: "1px solid var(--border-subtle)",
          paddingRight: "8px",
        },
      });

      const editorView = new EditorView({
        doc: postData.content_mdx || "",
        extensions: [
          basicSetup,
          markdown(),
          EditorView.lineWrapping,
          themeConfig,
          EditorView.updateListener.of((update) => {
            if (update.docChanged) {
              markDirty();
            }
          }),
        ],
        parent: container!,
      });

      // Synchronize title inputs & auto-generate slug with slugify
      function handleTitleInput(val: string) {
        if (topbarTitleInput && topbarTitleInput.value !== val) topbarTitleInput.value = val;
        if (postTitleField && postTitleField.value !== val) postTitleField.value = val;

        if (!isSlugManuallyEdited && val.trim()) {
          const autoSlug = slugify(val);
          if (postSlugField) {
            postSlugField.value = autoSlug;
            if (previewLink) previewLink.href = `/blog/${autoSlug}`;
          }
        }
        markDirty();
      }

      topbarTitleInput?.addEventListener("input", (e) => {
        handleTitleInput((e.target as HTMLInputElement).value);
      });

      postTitleField?.addEventListener("input", (e) => {
        handleTitleInput((e.target as HTMLInputElement).value);
      });

      postSlugField?.addEventListener("input", () => {
        isSlugManuallyEdited = true;
        if (previewLink) previewLink.href = `/blog/${postSlugField.value.trim()}`;
        markDirty();
      });

      resyncSlugBtn?.addEventListener("click", () => {
        const title = topbarTitleInput.value.trim() || postTitleField.value.trim();
        if (title) {
          const autoSlug = slugify(title);
          postSlugField.value = autoSlug;
          isSlugManuallyEdited = false;
          if (previewLink) previewLink.href = `/blog/${autoSlug}`;
          markDirty();
        }
      });

      // Form change listeners
      [postTemplateSelect, postDefaultWidthField, postWideWidthField, postDescField, postCategoryField, postAuthorField, postPubdateField, postStatusSelect, postTagsField, postImageField].forEach((el) => {
        el?.addEventListener("input", () => {
          markDirty();
        });
        el?.addEventListener("change", () => {
          markDirty();
        });
      });

      // Panel Navigation Logic
      function setPanel(panel: "settings" | "blocks" | "none") {
        activePanel = panel;
        if (panel === "none") {
          drawer?.classList.remove("open");
          toggleSettingsBtn?.classList.remove("active");
          toggleBlocksBtn?.classList.remove("active");
        } else if (panel === "settings") {
          drawer?.classList.add("open");
          settingsPanel?.classList.add("active");
          blocksPanel?.classList.remove("active");
          if (drawerHeading) drawerHeading.textContent = "Article Settings";
          toggleSettingsBtn?.classList.add("active");
          toggleBlocksBtn?.classList.remove("active");
        } else if (panel === "blocks") {
          drawer?.classList.add("open");
          blocksPanel?.classList.add("active");
          settingsPanel?.classList.remove("active");
          if (drawerHeading) drawerHeading.textContent = "Component Blocks";
          toggleBlocksBtn?.classList.add("active");
          toggleSettingsBtn?.classList.remove("active");
        }
      }

      toggleSettingsBtn?.addEventListener("click", () => {
        setPanel(activePanel === "settings" ? "none" : "settings");
      });

      toggleBlocksBtn?.addEventListener("click", () => {
        setPanel(activePanel === "blocks" ? "none" : "blocks");
      });

      drawerCloseBtn?.addEventListener("click", () => {
        setPanel("none");
      });

      // Helper for snippet insertion
      function insertSnippet(snippet: string) {
        const { from, to } = editorView.state.selection.main;
        editorView.dispatch({
          changes: { from, to, insert: snippet },
          selection: { anchor: from + snippet.length },
        });
        editorView.focus();
        markDirty();
      }

      // Markdown Formatting Engine with Caret & Selection Rules
      function applyFormatting(tool: string) {
        const selection = editorView.state.selection.main;
        const hasSelection = !selection.empty;
        const selectedText = editorView.state.sliceDoc(selection.from, selection.to);

        let insertText = "";
        let newAnchor = selection.from;
        let newHead = selection.from;

        switch (tool) {
          case "bold":
            if (hasSelection) {
              insertText = `**${selectedText}**\n`;
              newAnchor = selection.from + insertText.length;
              newHead = newAnchor;
            } else {
              insertText = `****`;
              newAnchor = selection.from + 2; // Caret inside: **|**
              newHead = newAnchor;
            }
            break;

          case "italic":
            if (hasSelection) {
              insertText = `*${selectedText}*\n`;
              newAnchor = selection.from + insertText.length;
              newHead = newAnchor;
            } else {
              insertText = `**`;
              newAnchor = selection.from + 1; // Caret inside: *|*
              newHead = newAnchor;
            }
            break;

          case "strike":
            if (hasSelection) {
              insertText = `~~${selectedText}~~\n`;
              newAnchor = selection.from + insertText.length;
              newHead = newAnchor;
            } else {
              insertText = `~~~~`;
              newAnchor = selection.from + 2; // Caret inside: ~~|~~
              newHead = newAnchor;
            }
            break;

          case "link":
            if (hasSelection) {
              insertText = `[${selectedText}]()\n`;
              newAnchor = selection.from + insertText.length;
              newHead = newAnchor;
            } else {
              insertText = `[]()`;
              newAnchor = selection.from + 1; // Caret inside: [|]()
              newHead = newAnchor;
            }
            break;

          case "h1":
          case "h2":
          case "h3":
          case "h4":
          case "h5":
          case "h6": {
            const level = parseInt(tool.replace("h", ""), 10);
            const prefix = "#".repeat(level) + " ";
            if (hasSelection) {
              insertText = `${prefix}${selectedText}\n`;
              newAnchor = selection.from + insertText.length;
              newHead = newAnchor;
            } else {
              insertText = prefix;
              newAnchor = selection.from + prefix.length;
              newHead = newAnchor;
            }
            break;
          }

          case "quote":
            if (hasSelection) {
              insertText = `> ${selectedText}\n`;
              newAnchor = selection.from + insertText.length;
              newHead = newAnchor;
            } else {
              insertText = `> `;
              newAnchor = selection.from + 2;
              newHead = newAnchor;
            }
            break;

          case "code":
            if (hasSelection) {
              insertText = `\`\`\`\n${selectedText}\n\`\`\`\n`;
              newAnchor = selection.from + insertText.length;
              newHead = newAnchor;
            } else {
              insertText = `\`\`\`\n\n\`\`\``;
              newAnchor = selection.from + 4; // Inside empty code block
              newHead = newAnchor;
            }
            break;

          case "bullet":
            if (hasSelection) {
              insertText = `- ${selectedText}\n`;
              newAnchor = selection.from + insertText.length;
            } else {
              insertText = `- `;
              newAnchor = selection.from + 2;
            }
            newHead = newAnchor;
            break;

          case "numbered":
            if (hasSelection) {
              insertText = `1. ${selectedText}\n`;
              newAnchor = selection.from + insertText.length;
            } else {
              insertText = `1. `;
              newAnchor = selection.from + 3;
            }
            newHead = newAnchor;
            break;
        }

        editorView.dispatch({
          changes: { from: selection.from, to: selection.to, insert: insertText },
          selection: { anchor: newAnchor, head: newHead },
        });
        editorView.focus();
        markDirty();
      }

      // Formatting Toolbar Click Handlers
      document.querySelectorAll(".tool-btn[data-tool]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tool = (btn as HTMLElement).dataset.tool;
          if (tool) applyFormatting(tool);
        });
      });

      // Component Blocks Insertion
      document.querySelectorAll(".btn-insert-block").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.currentTarget as HTMLElement;
          const type = target.dataset.insert;
          if (type === "amazon") {
            insertSnippet(
              `\n<AmazonProduct\n  asin="B08N5WRWNW"\n  title="Product Name"\n  price="$29.99"\n  rating={4.5}\n  image="/uploads/product.webp"\n/>\n`
            );
          } else if (type === "youtube") {
            insertSnippet(
              `\n<YouTube id="dQw4w9WgXcQ" title="Video Title" stretch="wide" />\n`
            );
          } else if (type === "list") {
            insertSnippet(
              `\n<Ul list-style-type="disc">\n  <li>First key takeaway</li>\n  <Ol list-style-type="roman">\n    <li>Nested roman detail 1</li>\n    <li>Nested roman detail 2</li>\n  </Ol>\n  <li>Second key takeaway</li>\n</Ul>\n`
            );
          } else if (type === "related") {
            insertSnippet(
              `\n<RelatedPosts category="${postCategoryField.value || 'General'}" limit={3} />\n`
            );
          } else if (type === "schema") {
            insertSnippet(
              `\n<Schema type="FAQPage">\n  {JSON.stringify({\n    "@context": "https://schema.org",\n    "@type": "FAQPage",\n    "mainEntity": [\n      {\n        "@type": "Question",\n        "name": "What is Astro?",\n        "acceptedAnswer": {\n          "@type": "Answer",\n          "text": "Astro is the web framework for content-driven websites."\n        }\n      }\n    ]\n  })}\n</Schema>\n`
            );
          }
        });
      });

      // Callouts insertion
      document.querySelectorAll(".btn-callout").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const variant = (e.currentTarget as HTMLElement).dataset.callout || "note";
          insertSnippet(`\n<Callout variant="${variant}">\n  Enter callout explanation here.\n</Callout>\n`);
        });
      });

      // ==================== Asset Picker Modal Logic ====================
      const assetModal = document.getElementById("editor-asset-modal") as HTMLDialogElement;
      const openAssetModalBtn = document.getElementById("open-asset-modal-btn");
      const closeAssetModalBtn = document.getElementById("close-asset-modal-btn");
      const cancelAssetModalBtn = document.getElementById("cancel-asset-modal-btn");
      const confirmAssetModalBtn = document.getElementById("confirm-asset-modal-btn") as HTMLButtonElement;
      const modalSearchInput = document.getElementById("modal-asset-search") as HTMLInputElement;
      const modalAssetsGrid = document.getElementById("modal-assets-grid");
      const selectedAssetInfo = document.getElementById("selected-asset-info");
      const modalDropzone = document.getElementById("modal-dropzone");
      const modalFileInput = document.getElementById("modal-file-input") as HTMLInputElement;
      const modalUploadStatus = document.getElementById("modal-upload-status");
      const modalTabBtns = document.querySelectorAll(".modal-tab-btn");

      let pickerTarget: "editor" | "featured" = "editor";
      let pickedAsset: any = null;

      function openAssetPicker(target: "editor" | "featured") {
        pickerTarget = target;
        pickedAsset = null;
        if (confirmAssetModalBtn) {
          confirmAssetModalBtn.disabled = true;
          confirmAssetModalBtn.textContent = target === "featured" ? "Set as Featured Image" : "Insert into Article";
        }
        if (selectedAssetInfo) {
          selectedAssetInfo.innerHTML = `<span class="placeholder-text">Click an asset to select it</span>`;
        }
        switchModalTab("library");
        renderModalAssets();
        assetModal.showModal();
      }

      openAssetModalBtn?.addEventListener("click", () => openAssetPicker("editor"));
      browseHeroImageBtn?.addEventListener("click", () => openAssetPicker("featured"));

      closeAssetModalBtn?.addEventListener("click", () => assetModal.close());
      cancelAssetModalBtn?.addEventListener("click", () => assetModal.close());

      function switchModalTab(tab: "library" | "upload") {
        modalTabBtns.forEach((b) => {
          const btn = b as HTMLElement;
          if (btn.dataset.tab === tab) btn.classList.add("active");
          else btn.classList.remove("active");
        });

        const libPane = document.getElementById("tab-library-content");
        const uploadPane = document.getElementById("tab-upload-content");
        if (tab === "library") {
          libPane?.classList.add("active");
          uploadPane?.classList.remove("active");
        } else {
          uploadPane?.classList.add("active");
          libPane?.classList.remove("active");
        }
      }

      modalTabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tab = (btn as HTMLElement).dataset.tab as "library" | "upload";
          switchModalTab(tab);
        });
      });

      function renderModalAssets() {
        if (!modalAssetsGrid) return;
        const q = modalSearchInput?.value.trim().toLowerCase() || "";
        const filtered = allAssets.filter((a: any) => {
          if (!q) return true;
          return a.filename.toLowerCase().includes(q) || (a.title && a.title.toLowerCase().includes(q));
        });

        if (filtered.length === 0) {
          modalAssetsGrid.innerHTML = `<div class="modal-empty-state"><p>No assets found</p></div>`;
          return;
        }

        modalAssetsGrid.innerHTML = "";
        for (const a of filtered) {
          const card = document.createElement("div");
          card.className = `modal-asset-item ${pickedAsset?.id === a.id ? "selected" : ""}`;

          let thumb = "";
          if (a.mimeType.startsWith("image/")) {
            thumb = `<img src="${a.url}" alt="${a.filename}" loading="lazy" />`;
          } else {
            thumb = `
              <div class="file-icon-badge">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
                <span>${a.filename.split('.').pop()?.toUpperCase() || "FILE"}</span>
              </div>
            `;
          }

          card.innerHTML = `
            <div class="modal-asset-thumb">${thumb}</div>
            <span class="modal-asset-name" title="${a.filename}">${a.filename}</span>
          `;

          card.addEventListener("click", () => {
            document.querySelectorAll(".modal-asset-item").forEach((el) => el.classList.remove("selected"));
            card.classList.add("selected");
            pickedAsset = a;
            if (confirmAssetModalBtn) confirmAssetModalBtn.disabled = false;
            if (selectedAssetInfo) {
              selectedAssetInfo.innerHTML = `<strong>Selected:</strong> <span>${a.filename}</span>`;
            }
          });

          modalAssetsGrid.appendChild(card);
        }
      }

      modalSearchInput?.addEventListener("input", renderModalAssets);

      confirmAssetModalBtn?.addEventListener("click", () => {
        if (!pickedAsset) return;

        if (pickerTarget === "featured") {
          postImageField.value = pickedAsset.url;
          markDirty();
        } else {
          // Insert into editor
          if (pickedAsset.mimeType.startsWith("image/")) {
            insertSnippet(`\n![${pickedAsset.altText || pickedAsset.filename}](${pickedAsset.url})\n`);
          } else {
            insertSnippet(`\n<a href="${pickedAsset.url}" download="${pickedAsset.filename}">${pickedAsset.title || pickedAsset.filename}</a>\n`);
          }
        }
        assetModal.close();
      });

      // Modal Upload Handling
      modalDropzone?.addEventListener("click", () => modalFileInput?.click());
      modalDropzone?.addEventListener("dragover", (e) => {
        e.preventDefault();
        modalDropzone.classList.add("dragover");
      });
      modalDropzone?.addEventListener("dragleave", () => {
        modalDropzone.classList.remove("dragover");
      });
      modalDropzone?.addEventListener("drop", async (e) => {
        e.preventDefault();
        modalDropzone.classList.remove("dragover");
        if (e.dataTransfer?.files?.[0]) {
          await uploadFromModal(e.dataTransfer.files[0]);
        }
      });

      modalFileInput?.addEventListener("change", async () => {
        if (modalFileInput.files?.[0]) {
          await uploadFromModal(modalFileInput.files[0]);
          modalFileInput.value = "";
        }
      });

      async function uploadFromModal(file: File) {
        const isImg = file.type.startsWith("image/");
        const maxSize = isImg ? 2 * 1024 * 1024 : 25 * 1024 * 1024;
        const maxLabel = isImg ? "2 MiB" : "25 MiB";

        if (file.size > maxSize) {
          alert(`File "${file.name}" exceeds the ${maxLabel} size limit.`);
          return;
        }

        if (modalUploadStatus) {
          modalUploadStatus.textContent = `Uploading ${file.name}...`;
        }

        const formData = new FormData();
        formData.append("file", file);

        try {
          const res = await fetch("/api/admin/assets/upload", {
            method: "POST",
            body: formData,
          });
          const data = await res.json();
          if (data.success) {
            const newAsset = {
              id: data.assetId,
              filename: data.filename,
              originalName: file.name,
              mimeType: data.mimeType || file.type,
              byteSize: data.byteSize || file.size,
              url: data.url,
              title: data.filename,
              altText: data.filename,
              description: "",
              createdAt: new Date().toISOString(),
              updatedAt: new Date().toISOString(),
            };
            allAssets.unshift(newAsset);
            pickedAsset = newAsset;
            if (modalUploadStatus) modalUploadStatus.textContent = "Upload successful!";
            switchModalTab("library");
            renderModalAssets();
            if (confirmAssetModalBtn) confirmAssetModalBtn.disabled = false;
            if (selectedAssetInfo) {
              selectedAssetInfo.innerHTML = `<strong>Selected:</strong> <span>${newAsset.filename}</span>`;
            }
          } else {
            alert(data.error || "Upload failed");
            if (modalUploadStatus) modalUploadStatus.textContent = "";
          }
        } catch {
          alert("Error contacting server");
          if (modalUploadStatus) modalUploadStatus.textContent = "";
        }
      }

      // Save logic
      function markDirty() {
        isDirty = true;
        if (saveIndicator) {
          saveIndicator.className = "save-indicator unsaved";
          if (saveIndicatorText) saveIndicatorText.textContent = "Unsaved changes";
        }
        clearTimeout(autoSaveTimer);
        autoSaveTimer = setTimeout(() => {
          savePost();
        }, 1500);
      }

      async function savePost() {
        if (isSaving) return;
        isSaving = true;

        if (saveIndicator) {
          saveIndicator.className = "save-indicator saving";
          if (saveIndicatorText) saveIndicatorText.textContent = "Saving to D1...";
        }

        const tagsRaw = postTagsField?.value || "";
        const tagsArray = tagsRaw
          .split(",")
          .map((t) => t.trim())
          .filter(Boolean);

        const payload = {
          id: postData.id,
          slug: postSlugField.value.trim(),
          title: topbarTitleInput.value.trim() || "Untitled Article",
          description: postDescField.value.trim(),
          category: postCategoryField.value,
          tags: tagsArray,
          author: postAuthorField.value,
          featured_image: postImageField.value.trim(),
          content_mdx: editorView.state.doc.toString(),
          status: postStatusSelect.value,
          template: postTemplateSelect.value || "default",
          default_width: postDefaultWidthField?.value.trim() || "60rem",
          wide_width: postWideWidthField?.value.trim() || "70rem",
          pub_date: postPubdateField.value ? `${postPubdateField.value}T12:00:00.000Z` : undefined,
        };

        try {
          const res = await fetch("/api/admin/posts/save", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (data.success) {
            isDirty = false;
            if (saveIndicator) {
              saveIndicator.className = "save-indicator saved";
              if (saveIndicatorText) saveIndicatorText.textContent = "Saved to D1";
            }
            if (statusBadge) {
              statusBadge.className = `status-tag ${payload.status}`;
              statusBadge.textContent = payload.status === "published" ? "Published" : "Draft";
            }
          } else {
            if (saveIndicator) {
              saveIndicator.className = "save-indicator error";
              if (saveIndicatorText) saveIndicatorText.textContent = data.error || "Save error";
            }
          }
        } catch {
          if (saveIndicator) {
            saveIndicator.className = "save-indicator error";
            if (saveIndicatorText) saveIndicatorText.textContent = "Network error";
          }
        } finally {
          isSaving = false;
        }
      }

      manualSaveBtn?.addEventListener("click", () => {
        clearTimeout(autoSaveTimer);
        savePost();
      });

      // Publish logic
      publishBtn?.addEventListener("click", async () => {
        if (isDirty) {
          await savePost();
        }

        const origHtml = publishBtn.innerHTML;
        publishBtn.innerHTML = `<span>Publishing...</span>`;

        try {
          const res = await fetch("/api/admin/posts/publish", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: postData.id }),
          });

          const data = await res.json();
          if (data.success) {
            postStatusSelect.value = "published";
            if (statusBadge) {
              statusBadge.className = "status-tag published";
              statusBadge.textContent = "Published";
            }
            alert(data.message || "Published successfully!");
          } else {
            alert(`Publishing failed: ${data.error}`);
          }
        } catch {
          alert("Error publishing article");
        } finally {
          publishBtn.innerHTML = origHtml;
        }
      });
    </script>

