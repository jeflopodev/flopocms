---
export const prerender = false;

import { eq, desc } from "drizzle-orm";
import { getDb, posts as postsTable, assets as assetsTable, type Post, type Asset } from "../../../lib/db";
import { templateOptions } from "../../../templates";
import { blockDefinitions } from "../../../blocks";
import "../../../styles/global.css";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/posts");
}

const db = getDb(Astro.locals);
const [post] = await db
  .select()
  .from(postsTable)
  .where(eq(postsTable.id, id))
  .limit(1);

if (!post) {
  return Astro.redirect("/admin/posts");
}

let initialAssets: Asset[] = [];
try {
  initialAssets = await db.select().from(assetsTable).orderBy(desc(assetsTable.createdAt));
} catch (err) {
  console.error("Failed to query assets:", err);
}

const user = Astro.locals.user || { username: post.author || "jeflopo" };

// Parse tags
let parsedTags: string[] = [];
try {
  if (post.tags) {
    const t = JSON.parse(post.tags);
    if (Array.isArray(t)) parsedTags = t;
  }
} catch {
  if (post.tags) parsedTags = [post.tags];
}

const rawPubDate = post.pubDate || (post as any).pub_date;
const pubDateFormatted = rawPubDate ? rawPubDate.split("T")[0] : new Date().toISOString().split("T")[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{post.title || "Untitled Article"} | Editor</title>
  </head>
  <body class="editor-workspace-body">
    <!-- Top Action Bar -->
    <header class="editor-topbar">
      <div class="topbar-left">
        <a href="/admin/posts" class="back-link" title="Back to Articles">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span class="back-text">Articles</span>
        </a>

        <div class="topbar-divider"></div>

        <div class="article-meta-header">
          <input
            type="text"
            id="topbar-title-input"
            class="topbar-title-input"
            value={post.title}
            placeholder="Article Title..."
          />
          <span id="post-status-badge" class:list={["status-tag", post.status]}>
            {post.status === "published" ? "Published" : "Draft"}
          </span>
        </div>
      </div>

      <div class="topbar-center">
        <div id="save-indicator" class="save-indicator saved">
          <span class="indicator-dot"></span>
          <span class="indicator-text">Saved to D1</span>
        </div>
      </div>

      <div class="topbar-right">
        <button type="button" id="manual-save-btn" class="btn btn-secondary" title="Save changes now">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
            <polyline points="17 21 17 13 7 13 7 21"/>
            <polyline points="7 3 7 8 15 8"/>
          </svg>
          Save
        </button>

        <a
          href={`/blog/${post.slug}`}
          target="_blank"
          id="preview-link"
          class="btn btn-secondary"
          title="Preview live article"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          Preview
        </a>

        <div class="topbar-divider"></div>

        <!-- Right Panels Toggles -->
        <button
          type="button"
          id="toggle-settings-btn"
          class="panel-toggle-btn active"
          title="Toggle Settings Panel"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          <span>Settings</span>
        </button>

        <button
          type="button"
          id="toggle-blocks-btn"
          class="panel-toggle-btn"
          title="Toggle Blocks Panel"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
          </svg>
          <span>Blocks</span>
        </button>

        <button type="button" id="publish-btn" class="btn btn-primary" title="Publish to GitHub main branch">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
          Publish
        </button>
      </div>
    </header>

    <!-- Workspace Viewport -->
    <main class="editor-workspace">
      <!-- Center: CodeMirror Editor & Toolbar -->
      <div class="editor-stage">
        <!-- Formatting Toolbar -->
        <div class="editor-toolbar">
          <div class="toolbar-group">
            <button type="button" class="tool-btn" data-tool="bold" title="Bold (****)">
              <strong>B</strong>
            </button>
            <button type="button" class="tool-btn" data-tool="italic" title="Italic (**)">
              <em>I</em>
            </button>
            <button type="button" class="tool-btn" data-tool="strike" title="Strikethrough (~~~~)">
              <s>S</s>
            </button>
          </div>

          <div class="toolbar-divider"></div>

          <!-- Headings H1 to H6 -->
          <div class="toolbar-group headings-group">
            <button type="button" class="tool-btn" data-tool="h1" title="Heading 1 (# )">H1</button>
            <button type="button" class="tool-btn" data-tool="h2" title="Heading 2 (## )">H2</button>
            <button type="button" class="tool-btn" data-tool="h3" title="Heading 3 (### )">H3</button>
            <button type="button" class="tool-btn" data-tool="h4" title="Heading 4 (#### )">H4</button>
            <button type="button" class="tool-btn" data-tool="h5" title="Heading 5 (##### )">H5</button>
            <button type="button" class="tool-btn" data-tool="h6" title="Heading 6 (###### )">H6</button>
          </div>

          <div class="toolbar-divider"></div>

          <div class="toolbar-group">
            <button type="button" class="tool-btn" data-tool="link" title="Link ([]())">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
            </button>
            <button type="button" class="tool-btn" data-tool="quote" title="Quote (> )">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>
                <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>
              </svg>
            </button>
            <button type="button" class="tool-btn" data-tool="code" title="Code Block (```)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </svg>
            </button>
          </div>

          <div class="toolbar-divider"></div>

          <div class="toolbar-group">
            <button type="button" class="tool-btn" data-tool="bullet" title="Bullet List (- )">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="8" y1="6" x2="21" y2="6"/>
                <line x1="8" y1="12" x2="21" y2="12"/>
                <line x1="8" y1="18" x2="21" y2="18"/>
                <line x1="3" y1="6" x2="3.01" y2="6"/>
                <line x1="3" y1="12" x2="3.01" y2="12"/>
                <line x1="3" y1="18" x2="3.01" y2="18"/>
              </svg>
            </button>
            <button type="button" class="tool-btn" data-tool="numbered" title="Numbered List (1. )">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="10" y1="6" x2="21" y2="6"/>
                <line x1="10" y1="12" x2="21" y2="12"/>
                <line x1="10" y1="18" x2="21" y2="18"/>
                <path d="M4 6h1v4"/>
                <path d="M4 10h2"/>
              </svg>
            </button>
          </div>

          <div class="toolbar-divider"></div>

          <!-- Global Asset Picker Tool Button -->
          <div class="toolbar-group">
            <button type="button" id="open-asset-modal-btn" class="tool-btn image-btn" title="Pick or upload global asset">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Add Media</span>
            </button>
          </div>
        </div>

        <!-- CodeMirror Host Element -->
        <div id="codemirror-container" class="codemirror-container"></div>
      </div>

      <!-- Right Docked Drawer (Settings by default, Blocks when toggled) -->
      <aside id="editor-drawer" class="editor-drawer open">
        <!-- Drawer Header -->
        <div class="drawer-header">
          <div class="drawer-title-group">
            <h2 id="drawer-heading" class="drawer-heading">Article Settings</h2>
            <span id="drawer-badge" class="drawer-badge">D1 Synced</span>
          </div>
          <button type="button" id="drawer-close-btn" class="drawer-close-btn" title="Close Panel (Full Width)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        <!-- Settings View Content -->
        <div id="settings-panel-content" class="panel-content active">
          <div class="form-group">
            <label for="post-title-field">Article Title</label>
            <input
              type="text"
              id="post-title-field"
              class="form-control"
              value={post.title}
              placeholder="Enter article title..."
            />
          </div>

          <div class="form-group">
            <div class="label-with-action">
              <label for="post-slug-field">URL Slug</label>
              <button type="button" id="resync-slug-btn" class="text-action-btn" title="Regenerate slug from title">
                Re-generate
              </button>
            </div>
            <div class="slug-input-wrapper">
              <span class="slug-prefix">/blog/</span>
              <input
                type="text"
                id="post-slug-field"
                class="form-control slug-field"
                value={post.slug}
                placeholder="url-slug"
              />
            </div>
            <span class="field-hint">Auto-generated via <code>slugify</code> from title</span>
          </div>

          <!-- Template Selector -->
          <div class="form-group">
            <label for="post-template-select">Layout Template</label>
            <select id="post-template-select" class="form-control">
              {templateOptions.map((t) => (
                <option value={t.id} selected={(post.template || "default") === t.id}>
                  {t.label}
                </option>
              ))}
            </select>
            <span class="field-hint">Single column vs Two columns (article | aside)</span>
          </div>

          <!-- Content & Wide Width Settings -->
          <div class="form-row">
            <div class="form-group flex-1">
              <label for="post-default-width-field">Default Width</label>
              <input
                type="text"
                id="post-default-width-field"
                class="form-control"
                value={post.defaultWidth || (post as any).default_width || "60rem"}
                placeholder="60rem"
              />
              <span class="field-hint">Standard prose (e.g. <code>60rem</code>)</span>
            </div>

            <div class="form-group flex-1">
              <label for="post-wide-width-field">Wide Width</label>
              <input
                type="text"
                id="post-wide-width-field"
                class="form-control"
                value={post.wideWidth || (post as any).wide_width || "70rem"}
                placeholder="70rem"
              />
              <span class="field-hint">Stretch breakout (e.g. <code>70rem</code>)</span>
            </div>
          </div>

          <div class="form-group">
            <label for="post-desc-field">SEO Description</label>
            <textarea
              id="post-desc-field"
              class="form-control"
              rows="3"
              placeholder="Concise summary for search engines and social cards..."
            >{post.description}</textarea>
          </div>

          <div class="form-row">
            <div class="form-group flex-1">
              <label for="post-category-field">Category</label>
              <select id="post-category-field" class="form-control">
                <option value="Web Development" selected={post.category === "Web Development"}>Web Development</option>
                <option value="Astro" selected={post.category === "Astro"}>Astro</option>
                <option value="Performance" selected={post.category === "Performance"}>Performance</option>
                <option value="CSS" selected={post.category === "CSS"}>CSS</option>
                <option value="TypeScript" selected={post.category === "TypeScript"}>TypeScript</option>
                <option value="General" selected={!post.category || post.category === "General"}>General</option>
              </select>
            </div>

            <div class="form-group flex-1">
              <label for="post-author-field">Author</label>
              <select id="post-author-field" class="form-control">
                <option value="jeflopo" selected={post.author === "jeflopo"}>@jeflopo</option>
                <option value="aflopo" selected={post.author === "aflopo"}>@aflopo</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group flex-1">
              <label for="post-pubdate-field">Publication Date</label>
              <input
                type="date"
                id="post-pubdate-field"
                class="form-control"
                value={pubDateFormatted}
              />
            </div>

            <div class="form-group flex-1">
              <label for="post-status-select">Status</label>
              <select id="post-status-select" class="form-control">
                <option value="draft" selected={post.status === "draft"}>Draft</option>
                <option value="published" selected={post.status === "published"}>Published</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="post-tags-field">Tags (Comma-separated)</label>
            <input
              type="text"
              id="post-tags-field"
              class="form-control"
              value={parsedTags.join(", ")}
              placeholder="e.g. astro, cloudflare, performance"
            />
          </div>

          <div class="form-group">
            <label for="post-image-field">Featured / Hero Image</label>
            <div class="input-with-button">
              <input
                type="text"
                id="post-image-field"
                class="form-control"
                value={post.featuredImage || ""}
                placeholder="/uploads/hero.webp"
              />
              <button type="button" id="browse-hero-image-btn" class="btn btn-secondary btn-sm" title="Pick from Asset Library">
                Browse
              </button>
            </div>
            <span class="field-hint">Global asset URL (e.g. <code>/uploads/hero.webp</code>)</span>
          </div>
        </div>

        <!-- Blocks View Content -->
        <div id="blocks-panel-content" class="panel-content">
          <div class="blocks-intro">
            <p>
              Click any block card to insert it into your article. All blocks are isolated, validated with Valibot, and globally imported!
            </p>
          </div>

          <!-- Callout Alerts Block Card -->
          <div class="block-card">
            <div class="block-card-header">
              <div class="block-icon alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                  <line x1="12" y1="9" x2="12" y2="13"/>
                  <line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
              </div>
              <div>
                <h3 class="block-title">&lt;Callout /&gt;</h3>
                <span class="block-desc">Accessible alert callouts</span>
              </div>
            </div>
            <div class="callout-insert-grid">
              <button type="button" class="btn-callout" data-callout="note">Note</button>
              <button type="button" class="btn-callout" data-callout="tip">Tip</button>
              <button type="button" class="btn-callout" data-callout="important">Important</button>
              <button type="button" class="btn-callout" data-callout="warning">Warning</button>
              <button type="button" class="btn-callout" data-callout="caution">Caution</button>
            </div>
          </div>

          <!-- Complex List Block Card -->
          <div class="block-card">
            <div class="block-card-header">
              <div class="block-icon list">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="8" y1="6" x2="21" y2="6"/>
                  <line x1="8" y1="12" x2="21" y2="12"/>
                  <line x1="8" y1="18" x2="21" y2="18"/>
                  <line x1="3" y1="6" x2="3.01" y2="6"/>
                  <line x1="3" y1="12" x2="3.01" y2="12"/>
                  <line x1="3" y1="18" x2="3.01" y2="18"/>
                </svg>
              </div>
              <div>
                <h3 class="block-title">&lt;Ul /&gt; &amp; &lt;Ol /&gt;</h3>
                <span class="block-desc">Nested list with custom list-style-type</span>
              </div>
            </div>
            <p class="block-preview-code">
              &lt;Ul list-style-type="disc"&gt;...&lt;/Ul&gt;
            </p>
            <button type="button" class="btn-insert-block" data-insert="list">
              + Insert Complex List
            </button>
          </div>

          <!-- Amazon Product Card -->
          <div class="block-card">
            <div class="block-card-header">
              <div class="block-icon amazon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="9" cy="21" r="1"/>
                  <circle cx="20" cy="21" r="1"/>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
              </div>
              <div>
                <h3 class="block-title">&lt;AmazonProduct /&gt;</h3>
                <span class="block-desc">Product showcase with global assets</span>
              </div>
            </div>
            <p class="block-preview-code">
              &lt;AmazonProduct asin="B0..." price="$..." image="/uploads/..." /&gt;
            </p>
            <button type="button" class="btn-insert-block" data-insert="amazon">
              + Insert Product Block
            </button>
          </div>

          <!-- YouTube Embed Card -->
          <div class="block-card">
            <div class="block-card-header">
              <div class="block-icon youtube">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
              </div>
              <div>
                <h3 class="block-title">&lt;YouTube /&gt;</h3>
                <span class="block-desc">Responsive video embed</span>
              </div>
            </div>
            <p class="block-preview-code">
              &lt;YouTube id="..." title="..." stretch="wide" /&gt;
            </p>
            <button type="button" class="btn-insert-block" data-insert="youtube">
              + Insert YouTube Video
            </button>
          </div>

          <!-- Related Posts Block Card (D1-powered) -->
          <div class="block-card">
            <div class="block-card-header">
              <div class="block-icon related">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="block-title">&lt;RelatedPosts /&gt;</h3>
                <span class="block-desc">D1 database query based on categories</span>
              </div>
            </div>
            <p class="block-preview-code">
              &lt;RelatedPosts category="{post.category || 'General'}" limit=3 /&gt;
            </p>
            <button type="button" class="btn-insert-block" data-insert="related">
              + Insert Related Posts
            </button>
          </div>

          <!-- JSON-LD Schema Card -->
          <div class="block-card">
            <div class="block-card-header">
              <div class="block-icon schema">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16.5 9.4 7.55 4.24a1.78 1.78 0 0 0-2.5 1.55v12.42a1.78 1.78 0 0 0 2.5 1.55L16.5 14.6a1.78 1.78 0 0 0 0-3.2z"/>
                </svg>
              </div>
              <div>
                <h3 class="block-title">&lt;Schema /&gt;</h3>
                <span class="block-desc">Structured FAQ / Article JSON-LD</span>
              </div>
            </div>
            <p class="block-preview-code">
              &lt;Schema type="FAQPage"&gt;...&lt;/Schema&gt;
            </p>
            <button type="button" class="btn-insert-block" data-insert="schema">
              + Insert Schema Block
            </button>
          </div>
        </div>
      </aside>
    </main>

    <!-- Centered Asset Picker Modal -->
    <dialog id="editor-asset-modal" class="editor-asset-dialog">
      <div class="asset-modal-shell">
        <div class="asset-modal-header">
          <div class="modal-tabs">
            <button type="button" class="modal-tab-btn active" data-tab="library">Asset Library</button>
            <button type="button" class="modal-tab-btn" data-tab="upload">Upload New Asset</button>
          </div>
          <button type="button" id="close-asset-modal-btn" class="modal-close-icon">&times;</button>
        </div>

        <div class="asset-modal-body">
          <!-- Library Tab -->
          <div id="tab-library-content" class="modal-tab-pane active">
            <div class="modal-search-row">
              <input
                type="text"
                id="modal-asset-search"
                class="form-control"
                placeholder="Search assets by filename..."
              />
            </div>
            <div id="modal-assets-grid" class="modal-assets-grid">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- Upload Tab -->
          <div id="tab-upload-content" class="modal-tab-pane">
            <div id="modal-dropzone" class="modal-dropzone">
              <input type="file" id="modal-file-input" class="file-input-hidden" accept="image/*,video/*,application/pdf,application/zip" />
              <div class="dropzone-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
              </div>
              <h4>Drag and drop a file, or <span class="browse-highlight">browse</span></h4>
              <p>Images up to 2 MiB, media/archives up to 25 MiB</p>
