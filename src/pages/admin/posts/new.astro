---
export const prerender = false;

import { getDb, posts } from "../../../lib/db";

const db = getDb(Astro.locals);

const user = Astro.locals.user || { username: "jeflopo" };

const id = crypto.randomUUID();
const suffix = Math.random().toString(36).substring(2, 7);
const slug = `untitled-${suffix}`;
const title = "Untitled Article";
const now = new Date().toISOString();

try {
  await db.insert(posts).values({
    id,
    slug,
    title,
    description: "",
    category: "General",
    tags: "[]",
    author: user.username,
    featuredImage: "",
    contentMdx: "",
    status: "draft",
    template: "default",
    pubDate: now,
    createdAt: now,
    updatedAt: now,
  });
} catch (err) {
  console.error("Failed to create new draft post:", err);
}

return Astro.redirect(`/admin/posts/${id}`);
---
