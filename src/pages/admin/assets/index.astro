---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { assetLibrarySummary } from "../../../lib/asset-library";
import { createServices } from "../../../lib/services";
import { type Asset } from "../../../lib/db";

const services = createServices(Astro.locals);

let assets: Asset[] = [];
try {
  assets = await services.assets.list();
} catch (err) {
  console.error("Fetch assets error:", err);
}

// The same figures the client renders the grid from, so "Total Weight" means one thing.
const library = assetLibrarySummary(assets);
---

<AdminLayout title="Asset Registry" activeTab="assets" fullWidth={true}>
  <div class="assets-viewport-page">
    <!-- Header -->
    <header class="page-header">
      <div>
        <h1 class="page-title">Asset Registry</h1>
        <p class="page-subtitle">
          Centralized media storage across the site. Upload once, reuse across any article and block component.
        </p>
      </div>

      <div class="header-stats">
        <div class="stat-pill">
          <span class="stat-num">{library.total}</span>
          <span class="stat-label">Total Assets</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">{library.totalLabel}</span>
          <span class="stat-label">Total Weight</span>
        </div>
      </div>
    </header>

    <!-- Dashed Upload Dropzone -->
    <section class="upload-dropzone-section">
      <div id="dropzone" class="upload-dropzone">
        <input
          type="file"
          id="global-file-input"
          class="file-input-hidden"
          accept="image/*,video/*,application/pdf,application/zip,audio/*"
          multiple
        />
        <div class="dropzone-content">
          <div class="dropzone-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
          </div>
          <div class="dropzone-text">
            <h3>Drag and drop files here, or <button type="button" id="browse-btn" class="browse-link-btn">browse files</button></h3>
            <p class="dropzone-limits">
              Supports <strong>Images</strong> (up to 2 MiB), <strong>Videos</strong>, <strong>PDFs</strong>, and <strong>ZIP archives</strong> (up to 25 MiB).
            </p>
          </div>
        </div>
        <div id="upload-progress-container" class="upload-progress-container hidden">
          <div class="progress-bar-track">
            <div id="upload-progress-bar" class="progress-bar-fill"></div>
          </div>
          <span id="upload-progress-text" class="progress-text">Uploading...</span>
          <ul id="upload-queue-list" class="upload-queue-list"></ul>
        </div>
      </div>
    </section>

    <!-- Filter & Search Controls -->
    <section class="controls-bar">
      <div class="search-input-wrapper">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          type="text"
          id="asset-search-input"
          class="filter-input"
          placeholder="Search by filename, title, or alt text..."
        />
        <button type="button" id="clear-search-btn" class="clear-btn hidden" title="Clear search">&times;</button>
      </div>

      <div class="filters-group">
        <div class="type-pills" role="radiogroup" aria-label="Filter by media type">
          <button type="button" class="type-pill active" data-type="all">All</button>
          <button type="button" class="type-pill" data-type="image">Images</button>
          <button type="button" class="type-pill" data-type="video">Videos</button>
          <button type="button" class="type-pill" data-type="document">Docs / ZIP</button>
        </div>

        <div class="sort-select-wrapper">
          <select id="asset-sort-select" class="sort-select">
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
            <option value="largest">Largest Size</option>
            <option value="smallest">Smallest Size</option>
            <option value="alpha">Alphabetical</option>
          </select>
        </div>
      </div>
    </section>

    <!-- Asset Cards Grid -->
    <main id="assets-grid" class="assets-grid">
      {assets.length === 0 ? (
        <div class="empty-state-card" id="empty-state">
          <div class="empty-icon">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
          <h3>No assets in the registry</h3>
          <p>Drag and drop your images, videos, or documents into the upload box above to get started.</p>
        </div>
      ) : null}
    </main>

    <!-- Initial Data Serialized for Client-Side Filtering & Modal -->
    <script id="assets-data" type="application/json" set:html={JSON.stringify(assets)} />
  </div>

  <!-- Asset Preview & Metadata Modal -->
  <dialog id="asset-modal" class="asset-modal">
    <div class="modal-shell">
      <div class="modal-header">
        <h2 id="modal-filename" class="modal-title">Asset Details</h2>
        <button type="button" id="modal-close-btn" class="modal-close-btn" title="Close modal">&times;</button>
      </div>

      <div class="modal-body">
        <!-- Preview Column -->
        <div class="preview-column">
          <div id="modal-preview-target" class="preview-target"></div>
          <div class="preview-actions">
            <button type="button" id="copy-url-btn" class="btn btn-secondary">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
              Copy URL
            </button>
            <button type="button" id="copy-snippet-btn" class="btn btn-secondary">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </svg>
              Copy Markdown
            </button>
          </div>
        </div>

        <!-- Metadata Form Column -->
        <div class="metadata-column">
          <form id="metadata-form">
            <input type="hidden" id="edit-asset-id" />

            <div class="form-group">
              <label for="edit-title">Title / Name</label>
              <input type="text" id="edit-title" class="form-control" placeholder="Friendly title for this asset..." />
            </div>

            <div class="form-group">
              <label for="edit-alt">Alt Text (For accessibility & SEO)</label>
              <input type="text" id="edit-alt" class="form-control" placeholder="Descriptive alternative text..." />
            </div>

            <div class="form-group">
              <label for="edit-desc">Description (Optional notes or captions)</label>
              <textarea id="edit-desc" class="form-control" rows="3" placeholder="Context or internal notes..."></textarea>
            </div>

            <div class="asset-meta-table">
              <div class="meta-row">
                <span class="meta-key">Relative URL:</span>
                <code id="meta-url" class="meta-val"></code>
              </div>
              <div class="meta-row">
                <span class="meta-key">MIME Type:</span>
                <span id="meta-mime" class="meta-val"></span>
              </div>
              <div class="meta-row">
                <span class="meta-key">File Size:</span>
                <span id="meta-size" class="meta-val"></span>
              </div>
              <div class="meta-row">
                <span class="meta-key">Uploaded:</span>
                <span id="meta-date" class="meta-val"></span>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" id="save-metadata-btn" class="btn btn-primary">
                Save Changes
              </button>
              <button type="button" id="delete-asset-btn" class="btn btn-danger">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"/>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                </svg>
                Delete
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </dialog>
</AdminLayout>

<script>
  import { insertionForAsset } from "../../../blocks/insertion";
  import {
    EMPTY_FILTER_MESSAGE,
    assetCard,
    assetLibraryView,
    type AssetSort,
    type AssetTypeFilter,
    type MediaKind,
  } from "../../../lib/asset-library";
  import { createUploadQueue, postAssetFile, type UploadItem } from "../../../lib/upload-queue";

  interface AssetData {
    id: string;
    filename: string;
    originalName: string;
    mimeType: string;
    byteSize: number;
    url: string;
    title: string;
    altText: string;
    description: string;
    createdAt: string;
    updatedAt: string;
  }

  // Load initial serialized data
  const dataScript = document.getElementById("assets-data");
  let allAssets: AssetData[] = JSON.parse(dataScript?.textContent || "[]");

  // DOM Elements
  const grid = document.getElementById("assets-grid") as HTMLElement;
  const searchInput = document.getElementById("asset-search-input") as HTMLInputElement;
  const clearSearchBtn = document.getElementById("clear-search-btn") as HTMLButtonElement;
  const sortSelect = document.getElementById("asset-sort-select") as HTMLSelectElement;
  const typePills = document.querySelectorAll(".type-pill");
  const dropzone = document.getElementById("dropzone");
  const fileInput = document.getElementById("global-file-input") as HTMLInputElement;
  const browseBtn = document.getElementById("browse-btn");
  const progressContainer = document.getElementById("upload-progress-container");
  const progressBar = document.getElementById("upload-progress-bar");
  const progressText = document.getElementById("upload-progress-text");

  // Modal Elements
  const modal = document.getElementById("asset-modal") as HTMLDialogElement;
  const modalCloseBtn = document.getElementById("modal-close-btn");
  const modalFilename = document.getElementById("modal-filename");
  const modalPreviewTarget = document.getElementById("modal-preview-target");
  const editAssetId = document.getElementById("edit-asset-id") as HTMLInputElement;
  const editTitle = document.getElementById("edit-title") as HTMLInputElement;
  const editAlt = document.getElementById("edit-alt") as HTMLInputElement;
  const editDesc = document.getElementById("edit-desc") as HTMLTextAreaElement;
  const metaUrl = document.getElementById("meta-url");
  const metaMime = document.getElementById("meta-mime");
  const metaSize = document.getElementById("meta-size");
  const metaDate = document.getElementById("meta-date");
  const copyUrlBtn = document.getElementById("copy-url-btn");
  const copySnippetBtn = document.getElementById("copy-snippet-btn");
  const metadataForm = document.getElementById("metadata-form");
  const deleteAssetBtn = document.getElementById("delete-asset-btn");

  let activeTypeFilter: AssetTypeFilter = "all";
  let activeSearchQuery = "";
  let activeSort: AssetSort = "newest";
  let currentSelectedAsset: AssetData | null = null;

  /** The card preview. Which element a kind gets is the page's business; the kind is not. */
  function previewFor(kind: MediaKind, asset: AssetData, altText: string): string {
    if (kind === "image") {
      return `<img src="${asset.url}" alt="${altText}" loading="lazy" class="card-thumb-img" />`;
    }

    if (kind === "video") {
      return `
        <div class="card-icon-preview video">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          <span class="preview-type-badge">VIDEO</span>
        </div>
      `;
    }

    return `
      <div class="card-icon-preview document">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        <span class="preview-type-badge">DOC</span>
      </div>
    `;
  }

  function renderGrid() {
    if (!grid) return;

    // Which Assets are shown, in which order, and what each card says: the view model
    // decides all of it, so the rules are testable without a browser.
    const cards = assetLibraryView(allAssets, {
      query: activeSearchQuery,
      type: activeTypeFilter,
      sort: activeSort,
    });

    if (cards.length === 0) {
      grid.innerHTML = `
        <div class="empty-filtered-card">
          <p>${EMPTY_FILTER_MESSAGE}</p>
        </div>
      `;
      return;
    }

    grid.innerHTML = "";

    for (const card of cards) {
      const asset = allAssets.find((candidate) => candidate.id === card.id);
      if (!asset) continue;

      const element = document.createElement("div");
      element.className = "asset-card";
      element.dataset.id = card.id;

      element.innerHTML = `
        <div class="card-thumb">${previewFor(card.kind, asset, card.altText)}</div>
        <div class="card-details">
          <div class="card-filename" title="${card.filename}">${card.filename}</div>
          <div class="card-meta">
            <span class="size-pill">${card.sizeLabel}</span>
            <span class="date-pill">${card.dateLabel}</span>
          </div>
        </div>
      `;

      element.addEventListener("click", () => openAssetModal(asset));
      grid.appendChild(element);
    }
  }

  function openAssetModal(asset: AssetData) {
    currentSelectedAsset = asset;
    const card = assetCard(asset);

    if (modalFilename) modalFilename.textContent = asset.filename;
    if (editAssetId) editAssetId.value = asset.id;
    if (editTitle) editTitle.value = asset.title || "";
    if (editAlt) editAlt.value = asset.altText || "";
    if (editDesc) editDesc.value = asset.description || "";
    if (metaUrl) metaUrl.textContent = asset.url;
    if (metaMime) metaMime.textContent = asset.mimeType;
    if (metaSize) metaSize.textContent = card.sizeLabel;
    if (metaDate) metaDate.textContent = card.dateTimeLabel;

    if (modalPreviewTarget) {
      if (card.kind === "image") {
        modalPreviewTarget.innerHTML = `<img src="${asset.url}" alt="${card.altText}" class="modal-hero-img" />`;
      } else if (card.kind === "video") {
        modalPreviewTarget.innerHTML = `
          <video src="${asset.url}" controls class="modal-hero-video"></video>
        `;
      } else {
        modalPreviewTarget.innerHTML = `
          <div class="modal-doc-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <a href="${asset.url}" target="_blank" download="${asset.filename}" class="btn btn-secondary">Download File</a>
          </div>
        `;
      }
    }

    modal.showModal();
  }

  modalCloseBtn?.addEventListener("click", () => {
    modal.close();
  });

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });

  // Copy buttons
  copyUrlBtn?.addEventListener("click", async () => {
    if (!currentSelectedAsset) return;
    await navigator.clipboard.writeText(currentSelectedAsset.url);
    const orig = copyUrlBtn.innerHTML;
    copyUrlBtn.innerHTML = `<span>Copied!</span>`;
    setTimeout(() => (copyUrlBtn.innerHTML = orig), 2000);
  });

  copySnippetBtn?.addEventListener("click", async () => {
    if (!currentSelectedAsset) return;
    // The same insertion the editor writes, so a copied asset can be pasted into an
    // Article and render as a real block instead of literal text.
    const snippet = insertionForAsset({
      url: currentSelectedAsset.url,
      mimeType: currentSelectedAsset.mimeType,
      label: currentSelectedAsset.altText || currentSelectedAsset.title,
      filename: currentSelectedAsset.filename,
    });
    await navigator.clipboard.writeText(snippet);
    const orig = copySnippetBtn.innerHTML;
    copySnippetBtn.innerHTML = `<span>Copied!</span>`;
    setTimeout(() => (copySnippetBtn.innerHTML = orig), 2000);
  });

  // Save Metadata
  metadataForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!currentSelectedAsset) return;

    const saveBtn = document.getElementById("save-metadata-btn");
    if (saveBtn) saveBtn.textContent = "Saving...";

    try {
      const res = await fetch("/api/admin/assets/update", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          id: currentSelectedAsset.id,
          title: editTitle.value.trim(),
          altText: editAlt.value.trim(),
          description: editDesc.value.trim(),
        }),
      });
      const data = await res.json();
      if (data.success) {
        currentSelectedAsset.title = editTitle.value.trim();
        currentSelectedAsset.altText = editAlt.value.trim();
        currentSelectedAsset.description = editDesc.value.trim();
        renderGrid();
        if (saveBtn) saveBtn.textContent = "Saved!";
        setTimeout(() => {
          if (saveBtn) saveBtn.textContent = "Save Changes";
        }, 1800);
      } else {
        alert(data.error || "Failed to update asset metadata");
        if (saveBtn) saveBtn.textContent = "Save Changes";
      }
    } catch {
      alert("Error contacting server");
      if (saveBtn) saveBtn.textContent = "Save Changes";
    }
  });

  // Delete Asset
  deleteAssetBtn?.addEventListener("click", async () => {
    if (!currentSelectedAsset) return;
    const confirmDelete = confirm(`Are you sure you want to permanently delete "${currentSelectedAsset.filename}"?`);
    if (!confirmDelete) return;

    deleteAssetBtn.textContent = "Deleting...";

    try {
      const res = await fetch("/api/admin/assets/delete", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: currentSelectedAsset.id }),
      });
      const data = await res.json();
      if (data.success) {
        allAssets = allAssets.filter((a) => a.id !== currentSelectedAsset?.id);
        modal.close();
        renderGrid();
      } else {
        alert(data.error || "Failed to delete asset");
        deleteAssetBtn.textContent = "Delete";
      }
    } catch {
      alert("Error contacting server");
      deleteAssetBtn.textContent = "Delete";
    }
  });

  // Filters & Search
  searchInput?.addEventListener("input", () => {
    activeSearchQuery = searchInput.value.trim();
    if (activeSearchQuery) {
      clearSearchBtn.classList.remove("hidden");
    } else {
      clearSearchBtn.classList.add("hidden");
    }
    renderGrid();
  });

  clearSearchBtn?.addEventListener("click", () => {
    searchInput.value = "";
    activeSearchQuery = "";
    clearSearchBtn.classList.add("hidden");
    renderGrid();
  });

  /** The Sort the select offers, narrowed from its value. */
  const SORTS: AssetSort[] = ["newest", "oldest", "largest", "smallest", "alpha"];
  const TYPES: AssetTypeFilter[] = ["all", "image", "video", "document"];

  sortSelect?.addEventListener("change", () => {
    const chosen = sortSelect.value as AssetSort;
    activeSort = SORTS.includes(chosen) ? chosen : "newest";
    renderGrid();
  });

  typePills.forEach((btn) => {
    btn.addEventListener("click", () => {
      typePills.forEach((p) => p.classList.remove("active"));
      btn.classList.add("active");
      const chosen = (btn as HTMLElement).dataset.type as AssetTypeFilter | undefined;
      activeTypeFilter = chosen && TYPES.includes(chosen) ? chosen : "all";
      renderGrid();
    });
  });

  // Upload Logic (Drag and Drop & Browse)
  browseBtn?.addEventListener("click", () => fileInput?.click());

  dropzone?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("dragover");
  });

  dropzone?.addEventListener("dragleave", () => {
    dropzone.classList.remove("dragover");
  });

  dropzone?.addEventListener("drop", async (e) => {
    e.preventDefault();
    dropzone.classList.remove("dragover");
    if (e.dataTransfer?.files?.length) {
      uploads.enqueue(e.dataTransfer.files);
    }
  });

  fileInput?.addEventListener("change", () => {
    if (fileInput.files?.length) {
      uploads.enqueue(fileInput.files);
    }
    fileInput.value = "";
  });

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  /** Every asset the queue finished uploading joins the grid, once. */
  const collectedUploads = new Set<string>();
  function collectUploaded(items: readonly UploadItem[]) {
    for (const item of items) {
      if (item.status !== "done" || !item.asset || collectedUploads.has(item.id)) continue;
      collectedUploads.add(item.id);

      const now = new Date().toISOString();
      allAssets.unshift({ ...item.asset, description: "", createdAt: now, updatedAt: now });
      renderGrid();
    }
  }

  function renderUploadQueue(items: readonly UploadItem[]) {
    if (items.length === 0) {
      progressContainer?.classList.add("hidden");
      return;
    }

    progressContainer?.classList.remove("hidden");

    const settled = items.filter(
      (item) => item.status !== "queued" && item.status !== "uploading"
    ).length;
    const busy = settled < items.length;

    if (progressBar) progressBar.style.width = `${Math.round((settled / items.length) * 100)}%`;
    if (progressText) {
      progressText.textContent = busy
        ? `Uploading ${settled + 1} of ${items.length}...`
        : "Upload complete.";
    }

    const queueList = document.getElementById("upload-queue-list");
    if (!queueList) return;

    queueList.innerHTML = items
      .map((item) => {
        const failed = item.status === "failed" || item.status === "rejected";
        const state = item.status === "done" ? "done" : failed ? "failed" : "busy";
        const note =
          item.error ||
          (item.status === "done" ? "Added to the library" : "Uploading…");
        const retry =
          item.status === "failed"
            ? `<button type="button" class="queue-action" data-retry="${item.id}">Retry</button>`
            : "";
        const dismiss = busy && item.status === "uploading"
          ? ""
          : `<button type="button" class="queue-action" data-dismiss="${item.id}">Dismiss</button>`;

        return `<li class="queue-item ${state}"><span class="queue-name" title="${escapeHtml(item.filename)}">${escapeHtml(item.filename)}</span><span class="queue-note">${escapeHtml(note)}</span>${retry}${dismiss}</li>`;
      })
      .join("");

    queueList.querySelectorAll<HTMLButtonElement>("[data-retry]").forEach((btn) => {
      btn.addEventListener("click", () => uploads.retry(btn.dataset.retry || ""));
    });
    queueList.querySelectorAll<HTMLButtonElement>("[data-dismiss]").forEach((btn) => {
      btn.addEventListener("click", () => uploads.dismiss(btn.dataset.dismiss || ""));
    });
  }

  // The queue owns the size verdict, the ordering and the retries; this script only decides
  // what it looks like. The same module drives the editor's Asset Modal.
  const uploads = createUploadQueue({
    post: postAssetFile,
    onChange: (items) => {
      collectUploaded(items);
      renderUploadQueue(items);
    },
  });

  // Initial render
  renderGrid();
</script>

<style>
  .assets-viewport-page {
    width: 100%;
    margin: 0 auto;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
    gap: 1.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .header-stats {
    display: flex;
    gap: 0.75rem;
  }

  .stat-pill {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .stat-num {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
  }

