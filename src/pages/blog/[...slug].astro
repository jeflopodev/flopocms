---
import { type CollectionEntry } from "astro:content";
import RootLayout from "#/layouts/root-layout.astro";
import { getVisibleBlogArticles } from "../../utils/articles";
import { getTemplateComponent } from "../../templates";
import { renderDocument } from "../../blocks/dsl";

export async function getStaticPaths() {
	const posts = await getVisibleBlogArticles();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { html, jsonLd, styles } = await renderDocument(post.body || "", {
  post: {
    id: post.id,
    slug: post.id,
    title: post.data.title,
    author: post.data.author,
    category: (post.data as any).category,
  },
});
const Template = getTemplateComponent(post.data.template);
---

<RootLayout hasMain={false} jsonLd={jsonLd} title={post.data.title} description={post.data.description}>
	<Template {...post.data}>
		<Fragment set:html={html} />
	</Template>
</RootLayout>

<style is:inline set:html={styles} />
