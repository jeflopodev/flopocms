---
import { type CollectionEntry, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import RootLayout from "#/layouts/root-layout.astro";
import { getVisibleBlogArticles } from "../../utils/articles";

export async function getStaticPaths() {
	const posts = await getVisibleBlogArticles();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const jsonLd = remarkPluginFrontmatter?.jsonLd;
---

<RootLayout class="blog-post-shell" jsonLd={jsonLd} title={post.data.title} description={post.data.description}>
	<BlogPost {...post.data}>
		<Content />
	</BlogPost>
</RootLayout>
