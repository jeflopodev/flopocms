---
import ArticleDisplay from "../../components/article-display.astro";
import { createEnvironmentReadModel, type Article } from "../../lib/article";
import { createGitBundleSource } from "../../lib/article-sources/git-bundle";

/**
 * Production reads the published Post Bundles from main at build time, and renders them
 * through Article Display — the same module Live Draft Preview renders through, which is
 * what keeps the two identical.
 */
export async function getStaticPaths() {
  // Built inside this function from imports only: getStaticPaths is hoisted out of the
  // frontmatter scope, so bindings declared below are not available inside it.
  const all = await createEnvironmentReadModel(createGitBundleSource()).listVisible();
  return all.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

type Props = { article: Article };

const { article } = Astro.props;
const articles = createEnvironmentReadModel(createGitBundleSource());
---

<ArticleDisplay article={article} articles={articles} mode="published" />
