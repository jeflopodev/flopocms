---
/**
 * Declarative Schema.org structured data component for MDX.
 * The Sätteri AST Schema Extractor parses this component at build time
 * and automatically incorporates its data into the page's unified JSON-LD @graph.
 */
interface Props {
  type: string;
  data: Record<string, any>;
}

const { type, data } = Astro.props;
---
