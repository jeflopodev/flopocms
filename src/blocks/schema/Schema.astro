---
import * as v from "valibot";
import { schemaBlockSchema, type SchemaBlockProps } from "./schema";

type Props = SchemaBlockProps;

const rawProps = Astro.props;
const parsed = v.safeParse(schemaBlockSchema, rawProps);
const { type } = parsed.success ? parsed.output : rawProps;
---

<!-- Schema: {type} is extracted at build time by Sätteri into the page <head> JSON-LD @graph -->
