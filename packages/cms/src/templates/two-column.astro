---
import { Image } from "astro:assets";
import { isBundledHeroImage, type ArticleTemplateProps } from "../lib/article";

/** The Article mapping in `toTemplateProps` is the only producer of these props. */
type Props = ArticleTemplateProps;

const {
  title,
  pubDate,
  updatedDate,
  heroImage,
  draft,
  author,
  defaultWidth = "60rem",
  wideWidth = "70rem",
} = Astro.props;

const formattedPubDate = pubDate ? new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate) : null;

const formattedUpdatedDate = updatedDate ? new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(updatedDate) : null;
---

<main
  class="site-main template-two-columns blog-post-shell"
  style={`--content-width: ${defaultWidth}; --default-width: ${defaultWidth}; --wide-width: ${wideWidth}; --wide-content-width: ${wideWidth};`}
>
  <article class="article-container">
    {draft && (
      <aside class="draft-banner" role="status">
        <div class="draft-banner-content">
          <span class="draft-indicator"></span>
          <div class="draft-banner-text">
            <strong>Draft Preview Mode</strong> &mdash; This article is authored by <code>@{author}</code> and will not be published to production until <code>draft: false</code> is set and merged into <code>main</code>.
          </div>
        </div>
      </aside>
    )}

    <div class="article-nav">
      <a href="/blog" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to all articles
      </a>
    </div>

    <header class="article-header">
      <div class="meta-row">
        {formattedPubDate && (
          <time datetime={pubDate.toISOString()} class="date-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            {formattedPubDate}
          </time>
        )}
        {formattedUpdatedDate && (
          <span class="updated-badge">
            (Updated: {formattedUpdatedDate})
          </span>
        )}
      </div>

      <h1 class="article-title">{title}</h1>
    </header>

    {heroImage && (
      <div class="hero-image-wrapper">
        {isBundledHeroImage(heroImage) ? (
          /* A bundle asset the build imported: measured, so it can be optimized. */
          <Image
            width={1100}
            height={550}
            src={heroImage}
            alt={title}
            class="hero-img"
            loading="eager"
          />
        ) : (
          /* An editorial URL: nothing measured it, so it renders as it is. */
          <img src={heroImage} alt={title} class="hero-img" loading="eager" />
        )}
      </div>
    )}

    <div class="prose">
      <slot />
    </div>
  </article>

  <!-- Two-column Aside: Empty by default for manual component placement -->
  <aside class="post-sidebar">
    <slot name="aside" />
  </aside>
</main>

<style>
  .site-main.template-two-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 3rem;
    max-width: var(--wide-width, 75rem);
    margin: 0 auto;
    padding: 2.5rem var(--page-padding, 1.5rem) 4rem;
    box-sizing: border-box;
    align-items: start;
    width: 100%;
  }

  @media (max-width: 960px) {
    .site-main.template-two-columns {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .article-container {
    width: 100%;
    min-width: 0;
  }

  .template-two-columns .prose {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .template-two-columns .prose > * {
    max-width: 100%;
  }

  .template-two-columns .prose > [data-stretch] {
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
  }

  .post-sidebar {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .article-nav {
    width: 100%;
    margin: 0 auto 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 500;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .back-link:hover {
    color: var(--primary-light);
    transform: translateX(-3px);
  }

  .article-header {
    width: 100%;
    margin: 0 auto 2.5rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .date-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--primary);
    background: rgba(99, 102, 241, 0.12);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(99, 102, 241, 0.25);
  }

  .updated-badge {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1rem;
    text-align: center;
  }

  .hero-image-wrapper {
    width: 100%;
    margin: 2.5rem auto 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
    background-color: var(--bg-surface);
  }

  .hero-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  .draft-banner {
    width: 100%;
    margin: 0 auto 2rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.35);
    backdrop-filter: blur(8px);
  }

  .draft-banner-content {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .draft-indicator {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #f59e0b;
    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.25);
    flex-shrink: 0;
    animation: pulse-draft 2s infinite ease-in-out;
  }

  @keyframes pulse-draft {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.9); }
  }

  .draft-banner-text {
    font-size: 0.9rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .draft-banner-text code {
    background: rgba(0, 0, 0, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
  }
</style>
