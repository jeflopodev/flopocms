{
  "name": "@jeflopodev/cms",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*.astro": "./src/*.astro",
    "./*.css": "./src/*.css",
    "./assets/*": "./src/assets/*",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "migrations",
    "scripts",
    "!**/*.test.ts",
    "!**/test/**"
  ],
  "bin": {
    "cms-project-view": "./scripts/project-published-view.mjs",
    "cms-create-user": "./scripts/create-user.mjs",
    "cms-check-images": "./scripts/check-image-sizes.mjs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "d1:migrate": "cf d1 migrations apply 8c1e6b53-e6f9-47a8-ac0d-9631b4234a48",
    "d1:migrate:local": "cf d1 migrations apply 8c1e6b53-e6f9-47a8-ac0d-9631b4234a48 --local",
    "cf:deploy": "astro build && node scripts/prepare-cf-output.mjs && cf deploy --prebuilt",
    "deploy": "astro build && node scripts/prepare-cf-output.mjs && cf deploy --prebuilt"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/state": "^6.7.5",
    "blocks": "github:jeflopodev/flopocms#path:packages/blocks",
    "codemirror": "^6.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "astro": "^7.3.2",
    "cf": "^1.0.0-beta.5",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
