{
  "name": "@jeflopodev/cms",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*.astro": "./src/*.astro",
    "./*.css": "./src/*.css",
    "./assets/*": "./src/assets/*",
    "./*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ]
  },
  "files": [
    "src",
    "migrations",
    "scripts",
    "!**/*.test.ts",
    "!**/test/**"
  ],
  "bin": {
    "cms-project-view": "./scripts/project-published-view.mjs",
    "cms-create-user": "./scripts/create-user.mjs",
    "cms-check-images": "./scripts/check-image-sizes.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/state": "^6.7.5",
    "blocks": "github:jeflopodev/flopocms#path:packages/blocks",
    "codemirror": "^6.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "astro": "^7.3.2",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
