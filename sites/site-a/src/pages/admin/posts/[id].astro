---
export const prerender = false;

import { type Asset } from "cms/lib/db";
import { createServices } from "cms/lib/services";
import type { PostRecord } from "cms/lib/post-store";
import { type LockResult } from "cms/lib/locks";
import { templateOptions } from "cms/templates";
import { getEditorBlockCards } from "blocks/registry";
import { TOOLBAR_GROUPS, getToolbarActions } from "blocks/toolbar";
import "cms/styles/global.css";
import "cms/styles/editor.css";

const editorCards = getEditorBlockCards();

// Toolbar buttons from the shipped blocks: removing a block removes its buttons.
// Groups with no buttons left render nothing, dividers included.
const toolbarActions = getToolbarActions();
const toolbarGroups = TOOLBAR_GROUPS.map((group) => ({
  ...group,
  buttons: toolbarActions.filter((action) => action.group === group.id),
})).filter((group) => group.buttons.length > 0);

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/posts");
}

const services = createServices(Astro.locals);

let loaded: PostRecord | null = null;
try {
  loaded = await services.posts.find(id);
} catch (err) {
  console.error("Failed to load post by id/slug:", err);
}

if (!loaded) {
  return Astro.redirect("/admin/posts");
}

const post: PostRecord = loaded;

// The middleware authenticates every /admin path, so there is no anonymous Editor to
// invent here — a page that reached this point without one would be a routing mistake.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/admin/login");
}

let initialLock: LockResult = { success: true, locked: false, isOwner: false };
try {
  initialLock = await services.locks.status(post.id, user.id);
} catch (err) {
  console.warn("Failed to get initial lock:", err);
}

let initialAssets: Asset[] = [];
try {
  initialAssets = await services.assets.list();
} catch (err) {
  console.error("Failed to list assets:", err);
}

// Parse tags
let parsedTags: string[] = [];
try {
  if (post.tags) {
    const t = JSON.parse(post.tags);
    if (Array.isArray(t)) parsedTags = t;
  }
} catch {
  if (post.tags) parsedTags = [post.tags];
}

// Compare-and-swap base the next publish/unpublish checks against: the bundle
// blob sha (`null` expects absent) and the `main` ref sha. Undefined when git
// is unavailable, which disables the precondition rather than blocking the save.
let expectedSha: string | null | undefined = undefined;
let expectedRef: string | undefined = undefined;
if (services.contents) {
  try {
    const bundle = await services.contents.readFile(
      `${services.contentDir}/${post.slug}/index.mdx`
    );
    expectedSha = bundle?.sha ?? null;
  } catch {
    expectedSha = undefined;
  }
  try {
    expectedRef = (await services.contents.refSha()) ?? undefined;
  } catch {
    expectedRef = undefined;
  }
}

const rawPubDate = post.pubDate;
const pubDateFormatted = rawPubDate ? String(rawPubDate).split("T")[0] : new Date().toISOString().split("T")[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{post.title || "Untitled Article"} | Editor</title>
  </head>
  <body class="editor-workspace-body">
    <!-- Top Action Bar -->
    <header class="editor-topbar">
      <div class="topbar-left">
        <a href="/admin/posts" class="back-link" title="Back to Articles">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span class="back-text">Articles</span>
        </a>

        <div class="topbar-divider"></div>

        <div class="article-meta-header">
          <input
            type="text"
            id="topbar-title-input"
            class="topbar-title-input"
            value={post.title}
            placeholder="Article Title..."
          />
          <span id="post-status-badge" class:list={["status-tag", post.status]}>
            {post.status === "published" ? "Published" : "Draft"}
          </span>
        </div>
      </div>

      <div class="topbar-center">
        <div id="save-indicator" class="save-indicator saved">
          <span class="indicator-dot"></span>
          <span class="indicator-text">Saved to D1</span>
        </div>
      </div>

      <div class="topbar-right">
        <!-- Right Panels Toggles -->
        <button
          type="button"
          id="toggle-settings-btn"
          class="panel-toggle-btn active"
          title="Toggle Settings Panel"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          <span>Settings</span>
        </button>

        <button
          type="button"
          id="toggle-blocks-btn"
          class="panel-toggle-btn"
          title="Toggle Blocks Panel"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
          </svg>
          <span>Blocks</span>
        </button>

        <div class="topbar-divider"></div>

        <!-- Dynamic Live/Draft Preview Link -->
        <a
          href={post.status === "published" ? `/blog/${post.slug}` : `/admin/posts/${post.id}/preview`}
          target="_blank"
          id="preview-link"
          class="btn btn-secondary action-preview-btn"
          title={post.status === "published" ? "View live published article" : "Preview draft with live styles"}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span id="preview-link-text">{post.status === "published" ? "View Live" : "Preview Draft"}</span>
        </a>

        <!-- Rightmost Action Buttons -->
        <!-- Secondary Button: Guardar Borrador (if draft) / Pasar a Borrador (if published) -->
        <button
          type="button"
          id="secondary-action-btn"
          class:list={["btn", "btn-secondary", "action-secondary-btn", { "btn-unpublish": post.status === "published" }]}
          title={post.status === "published" ? "Despublicar y retirar de producción" : "Guardar borrador en D1 (sin tocar Git)"}
          disabled={initialLock.locked}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
            <polyline points="17 21 17 13 7 13 7 21"/>
            <polyline points="7 3 7 8 15 8"/>
          </svg>
          <span id="secondary-btn-text">{post.status === "published" ? "Pasar a Borrador" : "Guardar Borrador"}</span>
        </button>

        <!-- Primary Button: Publicar (if draft) / Guardar Cambios (if published) -->
        <button
          type="button"
          id="primary-action-btn"
          class="btn btn-primary action-primary-btn"
          title={post.status === "published" ? "Guardar cambios y sincronizar en GitHub main" : "Publicar en GitHub main y desplegar a producción"}
          disabled={initialLock.locked}
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 19V5M5 12l7-7 7 7"/>
          </svg>
          <span id="primary-btn-text">{post.status === "published" ? "Guardar Cambios" : "Publicar"}</span>
        </button>
      </div>
    </header>

    <!-- Concurrency Lock Warning Banner -->
    <div id="lock-warning-banner" class:list={["lock-warning-banner", { hidden: !initialLock.locked }]}>
      <div class="lock-banner-inner">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span id="lock-warning-text">
          {initialLock.locked
            ? `This article is currently being edited by @${initialLock.lock?.username || "another editor"}. Read-Only Mode enabled.`
            : ""}
        </span>
      </div>
    </div>

    <!-- Workspace Viewport -->
    <main class="editor-workspace">
      <!-- Center: CodeMirror Editor & Toolbar -->
      <div class="editor-stage">
        <!-- Formatting Toolbar: buttons come from the shipped blocks, so removing
             a block removes its buttons. The asset picker below is site chrome. -->
        <div class="editor-toolbar">
          {toolbarGroups.map((group, groupIndex) => (
            <Fragment>
              {groupIndex > 0 && <div class="toolbar-divider"></div>}
              <div class:list={["toolbar-group", group.groupClass]}>
                {group.buttons.map((action) => (
                  <button type="button" class="tool-btn" data-tool={action.id} title={action.title}>
                    <Fragment set:html={action.bodyHtml} />
                  </button>
                ))}
              </div>
            </Fragment>
          ))}

          <div class="toolbar-divider"></div>

          <!-- Global Asset Picker Tool Button -->
          <div class="toolbar-group">
            <button type="button" id="open-asset-modal-btn" class="tool-btn image-btn" title="Pick or upload global asset">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Add Media</span>
            </button>
          </div>
        </div>

        <!-- CodeMirror Host Element -->
        <div id="codemirror-container" class="codemirror-container"></div>
      </div>

      <!-- Right Docked Drawer (Settings by default, Blocks when toggled) -->
      <aside id="editor-drawer" class="editor-drawer open">
        <!-- Drawer Header -->
        <div class="drawer-header">
          <div class="drawer-title-group">
            <h2 id="drawer-heading" class="drawer-heading">Article Settings</h2>
            <span id="drawer-badge" class="drawer-badge">D1 Synced</span>
          </div>
          <button type="button" id="drawer-close-btn" class="drawer-close-btn" title="Close Panel (Full Width)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        <!-- Settings View Content -->
        <div id="settings-panel-content" class="panel-content active">
          <div class="form-group">
            <label for="post-title-field">Article Title</label>
            <input
              type="text"
              id="post-title-field"
              class="form-control"
              value={post.title}
              placeholder="Enter article title..."
            />
          </div>

          <div class="form-group">
            <div class="label-with-action">
              <label for="post-slug-field">URL Slug</label>
              <button type="button" id="resync-slug-btn" class="text-action-btn" title="Regenerate slug from title">
                Re-generate
              </button>
            </div>
            <div class="slug-input-wrapper">
              <span class="slug-prefix">/blog/</span>
              <input
                type="text"
                id="post-slug-field"
                class="form-control slug-field"
                value={post.slug}
                placeholder="url-slug"
              />
            </div>
            <span class="field-hint">Auto-generated via <code>slugify</code> from title</span>
          </div>

          <!-- Template Selector -->
          <div class="form-group">
            <label for="post-template-select">Layout Template</label>
            <select id="post-template-select" class="form-control">
              {templateOptions.map((t) => (
                <option value={t.id} selected={(post.template || "default") === t.id}>
                  {t.label}
                </option>
              ))}
            </select>
            <span class="field-hint">Single column vs Two columns (article | aside)</span>
          </div>

          <!-- Content & Wide Width Settings -->
          <div class="form-row">
            <div class="form-group flex-1">
              <label for="post-default-width-field">Default Width</label>
              <input
                type="text"
                id="post-default-width-field"
                class="form-control"
                value={post.defaultWidth || "60rem"}
                placeholder="60rem"
              />
              <span class="field-hint">Standard prose (e.g. <code>60rem</code>)</span>
            </div>

            <div class="form-group flex-1">
              <label for="post-wide-width-field">Wide Width</label>
              <input
                type="text"
                id="post-wide-width-field"
                class="form-control"
                value={post.wideWidth || "70rem"}
                placeholder="70rem"
              />
              <span class="field-hint">Stretch breakout (e.g. <code>70rem</code>)</span>
            </div>
          </div>

          <div class="form-group">
            <label for="post-desc-field">SEO Description</label>
            <textarea
              id="post-desc-field"
              class="form-control"
              rows="3"
              placeholder="Concise summary for search engines and social cards..."
            >{post.description}</textarea>
          </div>

          <div class="form-row">
            <div class="form-group flex-1">
              <label for="post-category-field">Category</label>
              <select id="post-category-field" class="form-control">
                <option value="Web Development" selected={post.category === "Web Development"}>Web Development</option>
                <option value="Astro" selected={post.category === "Astro"}>Astro</option>
                <option value="Performance" selected={post.category === "Performance"}>Performance</option>
                <option value="CSS" selected={post.category === "CSS"}>CSS</option>
                <option value="TypeScript" selected={post.category === "TypeScript"}>TypeScript</option>
                <option value="General" selected={!post.category || post.category === "General"}>General</option>
              </select>
            </div>

            <div class="form-group flex-1">
              <label for="post-author-field">Author</label>
              <select id="post-author-field" class="form-control">
                <option value="jeflopo" selected={post.author === "jeflopo"}>@jeflopo</option>
                <option value="aflopo" selected={post.author === "aflopo"}>@aflopo</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group flex-1">
              <label for="post-pubdate-field">Publication Date</label>
              <input
                type="date"
                id="post-pubdate-field"
                class="form-control"
                value={pubDateFormatted}
              />
            </div>

            <div class="form-group flex-1">
              <label>Status</label>
              <div class="drawer-status-box">
                <span id="drawer-status-badge" class:list={["status-tag", post.status]}>
                  {post.status === "published" ? "Published" : "Draft"}
                </span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="post-tags-field">Tags (Comma-separated)</label>
            <input
              type="text"
              id="post-tags-field"
              class="form-control"
              value={parsedTags.join(", ")}
              placeholder="e.g. astro, cloudflare, performance"
            />
          </div>

          <div class="form-group">
            <label for="post-image-field">Featured / Hero Image</label>
            <div class="input-with-button">
              <input
                type="text"
                id="post-image-field"
                class="form-control"
                value={post.featuredImage || ""}
                placeholder="/uploads/hero.webp"
              />
              <button type="button" id="browse-hero-image-btn" class="btn btn-secondary btn-sm" title="Pick from Asset Library">
                Browse
              </button>
            </div>
            <span class="field-hint">Global asset URL (e.g. <code>/uploads/hero.webp</code>)</span>
          </div>
        </div>

        <!-- Blocks View Content -->
        <div id="blocks-panel-content" class="panel-content">
          <div class="blocks-intro">
            <p>
              Click any block card to insert it into your article. Every block is isolated, validated with Valibot, and rendered by the Document Renderer.
            </p>
          </div>

          <!-- Block cards are rendered from the Block Registry, so a new block adds no markup here.
               Each card inserts its primary snippet: a whole-card button, no preview, no inner buttons. -->
          {editorCards.map((card) => (
            <button
              type="button"
              class="block-card"
              data-snippet={`\n${card.insertions[0].snippet}\n`}
              title={`Insert ${card.tagName}`}
            >
              <div class="block-card-header">
                <div class="block-icon" set:html={card.icon} />
                <div>
                  <h3 class="block-title">{`<${card.tagName} />`}</h3>
                  <span class="block-desc">{card.description}</span>
                </div>
              </div>
            </button>
          ))}
        </div>
      </aside>
    </main>

    <!-- Centered Asset Picker Modal -->
    <dialog id="editor-asset-modal" class="editor-asset-dialog">
      <div class="asset-modal-shell">
        <div class="asset-modal-header">
          <div class="modal-tabs">
            <button type="button" class="modal-tab-btn active" data-tab="library">Asset Library</button>
            <button type="button" class="modal-tab-btn" data-tab="upload">Upload New Asset</button>
          </div>
          <button type="button" id="close-asset-modal-btn" class="modal-close-icon">&times;</button>
        </div>

        <div class="asset-modal-body">
          <!-- Library Tab -->
          <div id="tab-library-content" class="modal-tab-pane active">
            <div class="modal-search-row">
              <input
                type="text"
                id="modal-asset-search"
                class="form-control"
                placeholder="Search by filename, title, or alt text..."
              />
            </div>
            <div id="modal-assets-grid" class="modal-assets-grid">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- Upload Tab -->
          <div id="tab-upload-content" class="modal-tab-pane">
            <div id="modal-dropzone" class="modal-dropzone">
              <input type="file" id="modal-file-input" class="file-input-hidden" accept="image/*,video/*,application/pdf,application/zip" />
              <div class="dropzone-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
              </div>
              <h4>Drag and drop a file, or <span class="browse-highlight">browse</span></h4>
              <p>Images up to 2 MiB, media/archives up to 25 MiB</p>
              <div id="modal-upload-status" class="upload-status-text"></div>
            </div>
          </div>
        </div>

        <div class="asset-modal-footer">
          <div id="selected-asset-info" class="selected-asset-info">
            <span class="placeholder-text">No asset selected</span>
          </div>
          <div class="footer-actions">
            <button type="button" id="cancel-asset-modal-btn" class="btn btn-secondary">Cancel</button>
            <button type="button" id="confirm-asset-modal-btn" class="btn btn-primary" disabled>
              Insert Selected Asset
            </button>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Initial Data Payload. Only what the Editor Client cannot read from the DOM. -->
    <script id="initial-post-data" type="application/json" set:html={JSON.stringify({
      id: post.id,
      slug: post.slug,
      status: post.status || "draft",
      content_mdx: post.contentMdx || "",
      isInitiallyLocked: initialLock.locked,
      lockUser: initialLock.lock?.username || "",
      expected_sha: expectedSha,
      expected_ref: expectedRef,
    })} />

    <script id="initial-assets-data" type="application/json" set:html={JSON.stringify(initialAssets)} />

    <!-- Bootstrap Editor Client Module -->
    <script>
      import { initEditor } from "cms/scripts/editor";

      const dataScript = document.getElementById("initial-post-data");
      const postData = JSON.parse(dataScript?.textContent || "{}");

      const assetsScript = document.getElementById("initial-assets-data");
      const allAssets = JSON.parse(assetsScript?.textContent || "[]");

      initEditor({
        post: postData,
        assets: allAssets,
      });
    </script>
  </body>
</html>
