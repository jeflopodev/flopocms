---
import { Image } from "astro:assets";
import RootLayout from "#/layouts/root-layout.astro";
import { createEnvironmentReadModel, isBundledHeroImage } from "cms/lib/article";
import { createGitBundleSource } from "cms/lib/article-sources/git-bundle";

// Reads through the same seam as the Article pages: one visibility rule, one shape.
const posts = await createEnvironmentReadModel(createGitBundleSource()).listVisible();
---

<RootLayout title="Articles" class="blog-main">
  <div class="blog-container">
    <div class="archive-header">
      <span class="badge">Archive</span>
      <h1 class="archive-title">All Articles & Writings</h1>
      <p class="archive-desc">
        In-depth thoughts on engineering, frontend architecture, web standards, and lessons learned building modern applications.
      </p>
    </div>

    <div class="posts-list">
      {posts.map((post, index) => (
        <article class="post-item">
          <a href={`/blog/${post.slug}/`} class="post-card">
            {post.heroImage && (
              <div class="card-image-wrapper">
                {isBundledHeroImage(post.heroImage) ? (
                  <Image
                    width={900}
                    height={480}
                    src={post.heroImage}
                    alt={post.title}
                    class="card-img"
                  />
                ) : (
                  <img src={post.heroImage} alt={post.title} class="card-img" />
                )}
              </div>
            )}
            <div class="card-content">
              <div class="card-meta">
                {post.status === "draft" && <span class="draft-badge">Draft</span>}
                {index === 0 && post.status !== "draft" && <span class="featured-badge">Latest Article</span>}
                <time datetime={post.pubDate}>
                  {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(post.pubDate))}
                </time>
              </div>
              <h2 class="card-title">{post.title}</h2>
              <p class="card-desc">{post.excerpt || post.description}</p>
              <span class="read-more">
                Read article
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</RootLayout>

<style>
  :global(.site-main.blog-main) {
    max-width: 85rem;
  }

  .blog-container {
    width: 100%;
    margin: 0 auto;
  }

  .archive-header {
    text-align: center;
    max-width: 680px;
    margin: 1rem auto 3.5rem;
  }

  .archive-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 1rem 0 0.75rem;
  }

  .archive-desc {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  /* Vertical Posts List */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .post-card {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 2rem;
    padding: 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lg), 0 0 30px rgba(99, 102, 241, 0.15);
  }

  .card-image-wrapper {
    overflow: hidden;
    height: 100%;
    min-height: 280px;
    border-radius: var(--radius-md);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    transition: transform 0.4s ease;
  }

  .post-card:hover .card-img {
    transform: scale(1.03);
  }

  .card-content {
    padding: 1.25rem 1.25rem 1.25rem 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .featured-badge {
    background-color: var(--primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .draft-badge {
    background-color: rgba(245, 158, 11, 0.15);
    color: #d97706;
    border: 1px solid rgba(245, 158, 11, 0.4);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 0.75rem;
    transition: color var(--transition-fast);
  }

  .post-card:hover .card-title {
    color: var(--primary-light);
  }

  .card-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--primary-light);
    transition: gap var(--transition-fast);
  }

  .post-card:hover .read-more {
    gap: 0.75rem;
  }

  @media (max-width: 860px) {
    .post-card {
      grid-template-columns: 1fr;
      padding: 1rem;
      gap: 1.5rem;
    }
    .card-content {
      padding: 0 0.25rem 0.5rem;
    }
  }
</style>
