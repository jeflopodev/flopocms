{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-image-sizes.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:images": "node scripts/check-image-sizes.mjs",
    "deploy": "astro build && wrangler deploy",
    "new-article": "node scripts/new-article.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "d1:migrate": "wrangler d1 migrations apply DB",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "astro": "^7.3.2",
    "astro-auto-import": "^0.6.0",
    "codemirror": "^6.0.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@types/node": "^22.20.3",
    "wrangler": "^4.132.0"
  }
}