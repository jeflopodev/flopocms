{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-image-sizes.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:images": "node scripts/check-image-sizes.mjs",
    "deploy": "astro build && wrangler deploy",
    "create-user": "node scripts/create-user.mjs",
    "review:project": "node scripts/project-published-view.mjs",
    "d1:migrate": "wrangler d1 migrations apply DB",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:studio:remote": "drizzle-kit studio",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.5",
    "astro": "^7.3.2",
    "codemirror": "^6.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@types/node": "^22.20.3",
    "drizzle-kit": "1.0.0-rc.4",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}